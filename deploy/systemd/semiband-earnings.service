[Unit]
Description=SemiBand earnings/guidance stream (writes guidance.json)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=/opt/semiband
ExecStart=/opt/semiband/venv/bin/python earnings_stream.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
