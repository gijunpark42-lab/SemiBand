[Unit]
Description=SemiBand stock bot (P/S band + guidance exit)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=/opt/semiband
ExecStart=/opt/semiband/venv/bin/python run.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
