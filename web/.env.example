# Alpaca PAPER keys (same as the bot's .env)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# URL of trades.json in the (private) Vercel Blob store, e.g.
# https://<store-id>.private.blob.vercel-storage.com/trades.json
TRADES_URL=
# Blob store token; Vercel injects this automatically when the store is connected
BLOB_READ_WRITE_TOKEN=
